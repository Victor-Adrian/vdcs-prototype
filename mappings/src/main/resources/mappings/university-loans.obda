[PrefixDeclaration]
:       https://thesis.utwente.nl/vdcs/ontology/university#
r:      https://thesis.utwente.nl/vdcs/resource/
xsd:    http://www.w3.org/2001/XMLSchema#
rdf:    http://www.w3.org/1999/02/22-rdf-syntax-ns#

[MappingDeclaration] @collection [[

mappingId    map-loans
target       r:loan/{id} a :Loan ; :loanId {id}^^xsd:integer ; :loanTitle {title}^^xsd:string ; :borrowedOn {borrowed_on}^^xsd:string ; :returnedOn {returned_on}^^xsd:string . r:student/{student_id} :hasLoan r:loan/{id} .
source       SELECT id, student_id, title, borrowed_on, returned_on FROM loans

]]
