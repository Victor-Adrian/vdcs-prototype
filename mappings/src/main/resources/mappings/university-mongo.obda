[PrefixDeclaration]
:       https://thesis.utwente.nl/vdcs/ontology/university#
r:      https://thesis.utwente.nl/vdcs/resource/
xsd:    http://www.w3.org/2001/XMLSchema#
rdf:    http://www.w3.org/1999/02/22-rdf-syntax-ns#

[MappingDeclaration] @collection [[

mappingId    map-student-activities
target       r:activity/{student_id} a :StudentActivity ; :activityStudentId {student_id}^^xsd:integer . r:student/{student_id} :hasActivity r:activity/{student_id} .
source       SELECT student_id FROM student_activities

mappingId    map-club-memberships
target       r:club-membership/{id} a :ClubMembership ; :clubName {club_name}^^xsd:string ; :clubRole {club_role}^^xsd:string ; :joinedDate {joined_date}^^xsd:string . r:activity/{student_id} :hasClubMembership r:club-membership/{id} .
source       SELECT id, student_id, club_name, club_role, joined_date FROM club_memberships

mappingId    map-academic-projects
target       r:academic-project/{id} a :AcademicProject ; :projectTitle {title}^^xsd:string ; :projectYear {project_year}^^xsd:integer ; :projectStatus {status}^^xsd:string . r:activity/{student_id} :hasProject r:academic-project/{id} .
source       SELECT id, student_id, title, project_year, status FROM academic_projects

]]
